{
  "_comment": "Shared API keys (OpenAI, AssemblyAI, Anthropic, etc.) go in openclaw.json 'env' section — all agents inherit them automatically. Only per-user keys (like SuperMemory scoped keys) belong here.",
  "users": [
    {
      "id": "alice",
      "name": "Alice",
      "identifiers": [
        "+1234567890",
        "telegram:alice_handle",
        "discord:123456789"
      ],
      "env": {
        "SUPERMEMORY_OPENCLAW_API_KEY": "sm_scoped_alice_key"
      }
    },
    {
      "id": "bob",
      "name": "Bob",
      "identifiers": ["+0987654321"],
      "model": "openai/gpt-5.2",
      "env": {
        "SUPERMEMORY_OPENCLAW_API_KEY": "sm_scoped_bob_key"
      }
    }
  ],
  "defaults": {
    "dmScope": "per-peer",
    "model": "anthropic/claude-sonnet-4-5"
  }
}
